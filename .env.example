# ===== Server =====
PORT=3000
NODE_ENV=development
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG
# true jika backend diakses lewat HTTPS (wajib saat produksi)
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# Email yang otomatis memiliki perangkat smartplant_azarya_01 saat mendaftar (opsional)
DEVICE_OWNER_EMAIL=

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=potpintar
DB_PASSWORD=GANTI_PASSWORD_DB
DB_NAME=potpintar_db
# Harus sama dengan zona waktu server (WIB = +07:00)
DB_TIMEZONE=+07:00
TZ=Asia/Jakarta

# ===== MQTT (backend ke broker, TCP bukan WebSocket) =====
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_ROOT=potpintar
# Perangkat dianggap OFFLINE bila tidak ada telemetri/status melebihi detik ini
DEVICE_OFFLINE_AFTER_SEC=45
